# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://ais-pre-bodr7wggvyyl4p2jtskel4-749434257827.europe-west2.run.app"

# ============================================================================
# TIKTOK OAUTH 2.0 LOGIN KIT V2 CONFIGURATION (BACKEND ONLY — SECRET MANAGER)
# ============================================================================
# Exact HTTPS Redirect URIs to register in TikTok for Developers Portal:
# - Dev:  https://ais-dev-bodr7wggvyyl4p2jtskel4-749434257827.europe-west2.run.app/auth/tiktok/callback
# - Prod: https://ais-pre-bodr7wggvyyl4p2jtskel4-749434257827.europe-west2.run.app/auth/tiktok/callback
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="https://ais-pre-bodr7wggvyyl4p2jtskel4-749434257827.europe-west2.run.app/auth/tiktok/callback"

# OAUTH_ENCRYPTION_KEY: MANDATORY exclusive 256-bit (32-byte / 64 hex chars) key stored in Secret Manager
# Used to encrypt OAuth access_token and refresh_token at rest in Firestore with AES-256-GCM.
# Must NEVER equal TIKTOK_CLIENT_SECRET. Generate via: openssl rand -hex 32
OAUTH_ENCRYPTION_KEY=""

# OAUTH_ENCRYPTION_KEY_PREVIOUS: (OPTIONAL — only for future key rotation)
# Leave unset on initial installation. When rotating OAUTH_ENCRYPTION_KEY in the future,
# you may optionally set OAUTH_ENCRYPTION_KEY_PREVIOUS="<old_256_bit_key>" to keep existing sessions active.
# OAUTH_ENCRYPTION_KEY_PREVIOUS=""

# TIKTOK_OAUTH_SCOPES: Default is `user.info.basic` (provides open_id, display_name, avatar_url).
# `user.info.profile` (which provides username) is only requested if TIKTOK_PROFILE_SCOPE_APPROVED="true".
TIKTOK_OAUTH_SCOPES="user.info.basic"
TIKTOK_PROFILE_SCOPE_APPROVED="false"

# TIKTOK_OAUTH_USE_PKCE: Default "false" for standard TikTok Login Kit for Web confidential client flow.
# Set to "true" only if your client configuration explicitly requires PKCE S256 in the Web flow.
TIKTOK_OAUTH_USE_PKCE="false"

# ============================================================================
# MERCADO PAGO SUBSCRIPTIONS CONFIGURATION (BACKEND ONLY — SECRET MANAGER)
# ============================================================================
# MP_ACCESS_TOKEN: Token de acesso da aplicação Mercado Pago (use TEST-... para homologação).
# NUNCA exponha este token no frontend. Enquanto não configurado e homologado, a contratação permanece bloqueada (fail-closed).
MP_ACCESS_TOKEN=""

# MP_WEBHOOK_SECRET: Assinatura secreta para validação HMAC-SHA256 do cabeçalho x-signature nos webhooks.
MP_WEBHOOK_SECRET=""

# VITE_MP_PUBLIC_KEY: (Opcional — apenas caso a Alternativa A de Tokenização Transparente CardForm seja utilizada)
VITE_MP_PUBLIC_KEY=""

# ============================================================================
# ADMINISTRATIVE ACCESS CONTROL (BACKEND ONLY — SECRET MANAGER / CLOUD RUN)
# ============================================================================
# ADMIN_UIDS: Lista de UIDs autenticados do Firebase com privilégios administrativos exclusivos de backend.
# Separados por vírgula. Nunca expor no frontend ou client bundle.
ADMIN_UIDS=""
