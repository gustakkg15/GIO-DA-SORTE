rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny all unspecified operations
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile & Backend-Verified Subscription State
    function isValidUserProfile(data, userId) {
      return data.uid == userId
        && data.email is string
        && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (
          !('statusState' in data)
          || data.statusState in ['FREE', 'PENDING', 'PAST_DUE', 'CANCELED', 'EXPIRED']
          || (
            data.statusState == 'ACTIVE'
            && 'mpPreapprovalId' in data
            && data.mpPreapprovalId is string
            && data.mpPreapprovalId.size() > 0
            && 'mpExternalReference' in data
            && data.mpExternalReference == userId
          )
        );
    }

    // Validation for RaffleDocument
    function isValidRaffle(data, userId) {
      return data.userId == userId
        && data.userId == request.auth.uid
        && data.settings is map
        && data.participants is list
        && data.participants.size() <= 10000
        && (!('winners' in data) || data.winners is list);
    }

    // User Profile & Subscription State Rules (S-03: Strict Owner-Only Access; PII & Subscription Shielding)
    match /users/{userId} {
      // S-03: User document is strictly private to the authenticated owner. Enumeration (list) is strictly forbidden.
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection: Optional public organizer profile (read-only for participants, safe public fields)
      match /public/{profileId} {
        allow get: if isValidId(userId);
        allow list: if false;
        allow create, update: if isOwner(userId) && isValidId(userId);
        allow delete: if isOwner(userId) && isValidId(userId);
      }

      // Subcollection: Saved Raffles for this organizer (S-01: Direct client mutations strictly forbidden)
      match /raffles/{raffleId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update, delete: if false;

        // Permanent Traditional Draws (Written exclusively by Backend Admin SDK)
        match /draws/{drawId} {
          allow get, list: if isOwner(userId) && isValidId(userId);
          allow create, update, delete: if false;
        }

        // Idempotency Locks (Strictly private to Backend Admin SDK)
        match /idempotency/{idempotencyKey} {
          allow read, write: if false;
        }
      }

    // Subcollection: Permanent organizer raffle settings
      match /settings/{settingId} {
        allow get, list, create, update, delete: if isOwner(userId)
          && isValidId(userId)
          && isValidId(settingId);
      }
    }

    // Public Raffles: Published by signed-in organizers for participants to search by code or host
    match /public_raffles/{raffleCode} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(raffleCode) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(raffleCode) && incoming().userId == request.auth.uid && existing().userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(raffleCode) && existing().userId == request.auth.uid;
    }

    // ==========================================
    // RESOURCE OWNERSHIP HELPERS FOR LIVE & SPECIAL CAMPAIGNS
    // ==========================================

    function canReadResource() {
      return isSignedIn() && (
        !('ownerUid' in resource.data) ||
        resource.data.ownerUid == null ||
        resource.data.ownerUid == '' ||
        resource.data.ownerUid == request.auth.uid
      );
    }

    function isParentSessionOwner(sessionId) {
      return isSignedIn() && (
        !('ownerUid' in get(/databases/$(database)/documents/sessions/$(sessionId)).data) ||
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.ownerUid == null ||
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.ownerUid == request.auth.uid
      );
    }

    function isParentCampaignOwner(campaignId) {
      return isSignedIn() && (
        !('ownerUid' in get(/databases/$(database)/documents/campaigns/$(campaignId)).data) ||
        get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerUid == null ||
        get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerUid == request.auth.uid
      );
    }

    // ==========================================
    // TIKTOK LIVE & CAMPAIGNS COLLECTIONS (SEC-01 PROTECTED)
    // ==========================================

    // TikTok LIVE Sessions and subcollections (events, streaks, participants, tickets, draws)
    match /sessions/{sessionId} {
      allow get, list: if canReadResource();
      allow create: if isSignedIn()
        && isValidId(sessionId)
        && incoming().ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && isValidId(sessionId)
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid;
      allow delete: if isSignedIn()
        && isValidId(sessionId)
        && existing().ownerUid == request.auth.uid;

      match /{subcollection=**} {
        allow get, list: if isSignedIn() && isParentSessionOwner(sessionId);
        allow create, update: if isSignedIn() && isParentSessionOwner(sessionId);
        allow delete: if isSignedIn() && isParentSessionOwner(sessionId);
      }
    }

    // Global Lifetime Participants (and participations subcollection)
    match /global_participants/{tiktokUserId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(tiktokUserId);
      allow delete: if false;

      match /{subcollection=**} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn();
        allow delete: if false;
      }
    }

    // Special Campaigns (and sessions, tickets, snapshots, draws, cycles subcollections)
    match /campaigns/{campaignId} {
      allow get, list: if canReadResource();
      allow create: if isSignedIn()
        && isValidId(campaignId)
        && incoming().ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && isValidId(campaignId)
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid;
      allow delete: if isSignedIn()
        && isValidId(campaignId)
        && existing().ownerUid == request.auth.uid;

      match /{subcollection=**} {
        allow get, list: if isSignedIn() && isParentCampaignOwner(campaignId);
        allow create, update, delete: if isSignedIn() && isParentCampaignOwner(campaignId);
      }
    }

    // Draw Snapshots (and chunks subcollection for partitioned tickets)
    match /draw_snapshots/{snapshotId} {
      allow get, list: if canReadResource();
      allow create: if isSignedIn()
        && isValidId(snapshotId)
        && incoming().ownerUid == request.auth.uid;
      // Snapshots are immutable rosters frozen for audits — updates are strictly forbidden
      allow update: if false;
      allow delete: if isSignedIn()
        && isValidId(snapshotId)
        && existing().ownerUid == request.auth.uid;

      match /{subcollection=**} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn()
          && (!('ownerUid' in get(/databases/$(database)/documents/draw_snapshots/$(snapshotId)).data)
              || get(/databases/$(database)/documents/draw_snapshots/$(snapshotId)).data.ownerUid == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // Official Draws
    match /draws/{drawId} {
      allow get, list: if canReadResource();
      allow create: if isSignedIn()
        && isValidId(drawId)
        && incoming().ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && isValidId(drawId)
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid;
      allow delete: if isSignedIn()
        && isValidId(drawId)
        && existing().ownerUid == request.auth.uid;
    }

    // Conversion Rules Versioning
    match /ticket_rules/{ruleId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn()
        && isValidId(ruleId)
        && (
          (ruleId == 'org_defaults_' + request.auth.uid) ||
          (incoming().ownerUid == request.auth.uid)
        );
      allow delete: if isSignedIn()
        && isValidId(ruleId)
        && (
          (ruleId == 'org_defaults_' + request.auth.uid) ||
          (existing().ownerUid == request.auth.uid)
        );
    }

    // Audit Logs (Append-only immutable audit trail)
    match /audit_logs/{logId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(logId)
        && (
          !('operatorUid' in incoming()) ||
          incoming().operatorUid == request.auth.uid ||
          incoming().operatorUid == 'SYSTEM'
        );
      allow update: if false;
      allow delete: if false;
    }

    // ==========================================
    // LEGAL CENTER, LGPD, COOKIE CONSENT, SUPPORT & COMPLIANCE COLLECTIONS
    // ==========================================

    // Public Institutional & Legal Documents (15 official pages)
    match /legal_documents/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // Immutable Archived Legal Document Versions
    match /legal_document_versions/{versionId} {
      allow read: if true;
      allow write: if false;
    }

    // Explicit User Document Acceptances (Registration, PRO Activation, Policy Updates)
    match /document_acceptances/{acceptanceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(acceptanceId)
        && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }

    // LGPD Cookie Consent Records
    match /cookie_consents/{consentId} {
      allow read: if true;
      allow create: if isValidId(consentId)
        && incoming().consentId == consentId;
      allow update, delete: if false;
    }

    // LGPD Data Subject Requests (Access, Correction, Deletion, Portability, Revocation)
    match /lgpd_requests/{requestId} {
      allow get: if isSignedIn() && (
        !('userId' in resource.data) || resource.data.userId == request.auth.uid
      );
      allow list: if isSignedIn();
      allow create: if isValidId(requestId)
        && incoming().requestId == requestId;
      allow update, delete: if false;
    }

    // Support & Help Center Tickets with Protocol
    match /support_tickets/{ticketId} {
      allow get: if isSignedIn() && (
        !('userId' in resource.data) || resource.data.userId == request.auth.uid
      );
      allow list: if isSignedIn();
      allow create: if isValidId(ticketId)
        && incoming().ticketId == ticketId;
      allow update, delete: if false;
    }

    // Configurable Company & Legal Settings (Admin - mutated exclusively via backend)
    match /company_settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // Configurable Commercial Subscription Settings (Admin - mutated exclusively via backend)
    match /subscription_settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // Idempotent Mercado Pago Subscription Webhooks Log
    match /subscription_webhooks/{webhookId} {
      allow read: if false;
      allow create, update: if webhookId is string
        && incoming().webhookId == webhookId
        && incoming().dataId is string
        && incoming().processedAt is int;
      allow delete: if false;
    }

    // OAuth 2.0 CSRF State Store (Shared across Cloud Run instances)
    // Enumeration (list) is strictly forbidden; only exact SHA-256 hash lookup is allowed.
    // Enforces both numeric `expiresAt` (validated in all operations) and `ttlExpireAt` (Firestore TTL policy Timestamp).
    match /oauth_states/{stateHash} {
      allow get: if stateHash is string && stateHash.size() == 64 && stateHash.matches('^[a-f0-9]{64}$');
      allow list: if false;
      allow create: if stateHash is string && stateHash.size() == 64 && stateHash.matches('^[a-f0-9]{64}$')
        && incoming().stateHash == stateHash
        && incoming().expiresAt is int
        && incoming().ttlExpireAt is timestamp
        && incoming().consumed == false;
      allow update: if stateHash is string && stateHash.size() == 64 && stateHash.matches('^[a-f0-9]{64}$')
        && existing().consumed == false
        && incoming().consumed == true;
      allow delete: if stateHash is string && stateHash.size() == 64 && stateHash.matches('^[a-f0-9]{64}$');
    }

    // OAuth 2.0 Persistent Encrypted Sessions (AES-256-GCM encrypted tokens with exclusive 256-bit key)
    // Enumeration (list) is strictly forbidden; only exact SHA-256 session token hash lookup is allowed.
    // Enforces `sessionExpiresAt`, `refreshTokenExpiresAt`, and `ttlExpireAt` (Firestore TTL policy Timestamp).
    match /oauth_sessions/{sessionIdHash} {
      allow get: if sessionIdHash is string && sessionIdHash.size() == 64 && sessionIdHash.matches('^[a-f0-9]{64}$');
      allow list: if false;
      allow create, update: if sessionIdHash is string && sessionIdHash.size() == 64 && sessionIdHash.matches('^[a-f0-9]{64}$')
        && incoming().sessionIdHash == sessionIdHash
        && incoming().sessionExpiresAt is int
        && incoming().refreshTokenExpiresAt is int
        && incoming().ttlExpireAt is timestamp
        && incoming().encryptedAccessToken is map
        && incoming().encryptedRefreshToken is map
        && incoming().encryptedAccessToken.algorithm == 'aes-256-gcm'
        && incoming().encryptedAccessToken.keySource == 'SECRET_MANAGER_OAUTH_KEY';
      allow delete: if sessionIdHash is string && sessionIdHash.size() == 64 && sessionIdHash.matches('^[a-f0-9]{64}$');
    }

    // TikTok LIVE Diagnostic Events Collection (Dedicated observational storage with 24h TTL)
    match /tiktok_live_diagnostic_events/{traceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && traceId is string
        && incoming().traceId == traceId
        && incoming().expiresAt is int
        && incoming().ttlExpireAt is timestamp;
      allow delete: if isSignedIn();
    }

    // Provably Fair V2 Private Precommits (Strictly private to Backend Admin SDK)
    match /draw_precommits_private/{commitmentHash} {
      allow read, write: if false;
    }

    // Provably Fair V2 Public Audit Ledger (Read via backend API, no direct client writes)
    match /draw_ledger_public/{commitmentHash} {
      allow read: if true;
      allow write: if false;

      match /{subcollection=**} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}


